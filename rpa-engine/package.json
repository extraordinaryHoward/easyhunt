{
  "name": "easyhunt-rpa-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --import tsx src/server.ts",
    "start": "node --import tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "test:browser": "node --import tsx --test test/browser.test.ts",
    "inspect:boss": "node --import tsx src/inspect-boss.ts",
    "collect:boss": "node --import tsx src/collect-boss.ts",
    "resume:demo": "node --import tsx src/resume/run.ts",
    "agent:boss": "node --import tsx src/agent-boss.ts",
    "build": "tsc -p tsconfig.build.json",
    "start:built": "node dist/server.js"
  },
  "dependencies": {
    "fastify": "^5.6.0",
    "pdfjs-dist": "^5.6.205",
    "playwright": "^1.64.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
