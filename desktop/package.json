{
  "name": "easyhunt-desktop",
  "version": "0.7.2",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "dist:mac": "npm run build && electron-builder --mac dmg zip --publish never",
    "dist:win": "npm run build && electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "description": "Easyhunt AI recruitment desktop",
  "build": {
    "appId": "com.easyhunt.desktop",
    "productName": "Easyhunt",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "src/browser-toolbar.html",
      "src/preload.cjs"
    ],
    "extraResources": [
      {
        "from": "../user-webapp/dist",
        "to": "user-webapp"
      },
      {
        "from": "../rpa-engine/dist",
        "to": "rpa-engine/dist"
      },
      {
        "from": "../rpa-engine/node_modules",
        "to": "rpa-engine/node_modules",
        "filter": [
          "**/*",
          "!**/test/**",
          "!**/tests/**"
        ]
      },
      {
        "from": "../rpa-engine/package.json",
        "to": "rpa-engine/package.json"
      },
      {
        "from": "../docs/RPA引擎-命令规格.json",
        "to": "docs/RPA引擎-命令规格.json"
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
